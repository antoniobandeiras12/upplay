# ==============================================================================
# UpPlay — Configurações de Ambiente
# ==============================================================================

# Porta do Servidor Web e API (Padrão: 3000)
PORT=3000

# Caminho do Arquivo de Banco de Dados SQLite (Padrão: data/upplay.db)
DB_PATH=./data/upplay.db

# Segredo criptográfico para sessões e hashing de IPs para auditoria
SESSION_SECRET=coloque_uma_frase_longa_e_aleatoria_aqui_para_producao

# URL Externa direta para o arquivo APK do aplicativo Android
# Se preenchida, requisições em /download serão redirecionadas (302) para esta URL.
# Se vazia, o servidor busca o arquivo localmente em assets/downloads/UpPlay.apk
APK_DOWNLOAD_URL=

# Retenção automática de registros de auditoria em dias (Padrão: 90 dias)
DATA_RETENTION_DAYS=90

# Credenciais do Administrador Inicial (criado automaticamente caso a tabela esteja vazia)
# Recomendado alterar logo após a primeira inicialização via CLI: node server.js --create-admin <user> <pass>
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=UpPlay2026!
